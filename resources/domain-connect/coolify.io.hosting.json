{
    "providerId": "northlatch.com",
    "providerName": "Xlaunch",
    "serviceId": "hosting",
    "serviceName": "Xlaunch Hosting",
    "version": 1,
    "logoUrl": "https://northlatch.com/xlaunch-transparent.png",
    "description": "Point your domain to a Xlaunch-managed server via an A record.",
    "variableDescription": "ip is the Xlaunch server IP. host is the subdomain relative to the zone (empty for apex).",
    "syncPubKeyDomain": "domainconnect.northlatch.com",
    "syncBlock": false,
    "records": [
        {
            "type": "A",
            "host": "%host%",
            "pointsTo": "%ip%",
            "ttl": 3600
        }
    ]
}
